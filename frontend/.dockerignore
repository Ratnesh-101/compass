# Compass Frontend — .dockerignore
# Build context is ./frontend

# Dependencies (reinstalled inside container)
node_modules/

# Build output (rebuilt inside container)
dist/

# Local env files
.env
.env.*
.env.production*

# Python (shouldn't be here, but guard anyway)
**/__pycache__/
**/*.pyc

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
