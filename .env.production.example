# Compass — Production Environment Variables Template
# Copy to .env.production (NEVER commit .env.production to Git)

ENVIRONMENT=production
LOG_LEVEL=INFO

# === Authentication ===
AUTH_TOKEN=generate-a-cryptographically-secure-token-here

# === Neon Serverless PostgreSQL (Production) ===
DATABASE_URL=postgresql://neondb_owner:STRONG_PASSWORD@ep-sweet-fire-b2y9w95z.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require

# === Nebius Token Factory ===
NEBIUS_API_KEY=your_production_nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
ROUTER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
SKILL_MODEL=nvidia/nemotron-3-super-120b-a12b
SYNTHESIS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=768

# === CORS ===
CORS_ORIGINS=["https://compass.nebius.app","https://compass-frontend.vercel.app"]
