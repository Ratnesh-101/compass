# Compass — Environment Variables
# Copy to .env and fill in your values

# === Required ===
NEBIUS_API_KEY=your_nebius_api_key_here
AUTH_TOKEN=generate_a_random_token_here

# === Database ===
DATABASE_URL=postgresql://compass:compass@localhost:5432/compass

# === Nebius Token Factory ===
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
ROUTER_MODEL=nvidia/Nemotron-3-Nano-8B-v1
SKILL_MODEL=nvidia/nemotron-3-super-49b-v1
SYNTHESIS_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1
EMBEDDING_MODEL=BAAI/bge-en-icl
EMBEDDING_DIMENSION=768

# === App ===
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
