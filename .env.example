# Compass — Environment Variables
# Copy to .env and fill in your values

# === Environment Mode ===
# development | test | production (must be 'development' for local development)
ENVIRONMENT=development

# === Required ===
NEBIUS_API_KEY=your_nebius_api_key_here
AUTH_TOKEN=generate_a_random_token_here

# === Database ===
# DATABASE_URL (dev) and TEST_DATABASE_URL must target different Neon branches (e.g. dev branch ep-broad-recipe vs ci-test branch).
# The test runner will refuse to run if TEST_DATABASE_URL and DATABASE_URL point to the same host/database.
DATABASE_URL=postgresql://compass:compass@localhost:5432/compass
TEST_DATABASE_URL=postgresql://compass:compass@localhost:5432/compass_test
PROTECTED_DB_HOSTS=

# === Nebius Token Factory ===
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
ROUTER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
SKILL_MODEL=nvidia/nemotron-3-super-120b-a12b
SYNTHESIS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=768

# === App ===
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === Google Calendar OAuth (Optional) ===
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback
TOKEN_ENCRYPTION_KEY=your_secure_random_32_byte_key_here!

# === Tavily Search ===
TAVILY_API_KEY=tvly-your-key-here
TAVILY_ENABLED=true
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_S=12.0

# === Safety Gates & Demo Seeding ===
# Explicit opt-in required to run scripts/seed_usage.py against local dev fixtures.
# Must remain unset or false in production environments.
ALLOW_SEED=false

# 1-Click "Load Judge Persona" seeding gate (/api/demo/seed and /api/demo/seed-persona).
# Off by default. Set to true only on a local development machine to try the demo persona.
# Never enable it on a production server.
ENABLE_DEMO_SEEDING=false

